# Supabase project URL and browser-safe publishable key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only Supabase key. Never expose this in browser code.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# FCM server credentials. Keep these server-only and store the service-account
# JSON as one escaped JSON string in your deployment secret manager.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
NEXT_PUBLIC_FCM_VAPID_KEY=BEh5stAv8uDSX2Lo3Rv0CmYETju-ucBSCuvH2tFLFWFRHC1YA1kPPomHjJFsNDPnV1ug7e1xfmMsn73qjUtLcBY

# Supabase Database Webhook authentication (a long random value, not an API key).
SUPABASE_WEBHOOK_SECRET=iKWHAJ9GHO7zOvTXh3QtU4D6dVpKjfvx5NLcshhyTRM

# Copy the Session pooler URI from Supabase Dashboard → Connect.
# Keep sslmode=require and URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
